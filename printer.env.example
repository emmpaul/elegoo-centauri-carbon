# Settings for the printer service container (compose.yaml). Copy this file to
# printer.env, which git ignores, and fill it in. Never commit printer.env.

# Required. The printer's LAN address. Give the printer a fixed address (a DHCP
# reservation on the router): UDP discovery does not work from the container.
PRINTER_IP=192.0.2.10

# Required. Access token for the dashboard and API; the service refuses to
# start without one. Generate it with: openssl rand -hex 32
ACCESS_TOKEN=replace-with-a-long-random-token

# Optional. ntfy push notifications; no topic means no notifications.
#NTFY_URL=https://ntfy.sh
#NTFY_TOPIC=
# Optional. Comma-separated events to notify (started, finished, failed,
# paused, stopped, offline, online), or "none". Default: all of them.
#NOTIFY_EVENTS=

# Leave LISTEN_HOST and LISTEN_PORT unset: inside the container the service
# listens on 0.0.0.0:8080, and compose.yaml publishes that port.
