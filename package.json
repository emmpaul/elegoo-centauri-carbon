{
  "name": "elegoo-centauri-carbon",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Local-first control, dashboard, and notifications for the Elegoo Centauri Carbon over SDCP",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "node src/main.ts",
    "start:fake": "node scripts/run-fake-service.ts",
    "notify:test": "node scripts/send-test-notification.ts",
    "fonts:fetch": "node scripts/fetch-fonts.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p web/tsconfig.sw.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  },
  "license": "MIT"
}
